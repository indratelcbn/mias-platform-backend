// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (Admin) ─────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  nama      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artikel  Artikel[]
  kajian   Kajian[]

  @@map("users")
}

enum Role {
  ADMIN
  SUPERADMIN
  SOSIAL
  DAKWAH
  PENDIDIKAN
  USAHA
  KEUANGAN
}

// ─── Role Permissions ─────────────────────────────────────────────────────────
model RolePermission {
  id      String @id @default(uuid())
  role    Role
  menuKey String @map("menu_key")

  @@unique([role, menuKey])
  @@map("role_permissions")
}

// ─── Kajian ───────────────────────────────────────────────────────────────────
model Kajian {
  id          String   @id @default(uuid())
  judul       String
  ustadz      String
  tanggal     DateTime
  waktu       String
  lokasi      String?
  deskripsi   String?
  thumbnail   String?
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   String?  @map("created_by")
  creator     User?    @relation(fields: [createdBy], references: [id])

  @@map("kajian")
}

// ─── Artikel ──────────────────────────────────────────────────────────────────
model Artikel {
  id              String    @id @default(uuid())
  judul           String
  slug            String    @unique
  konten          String
  ringkasan       String?
  thumbnail       String?
  kategori        String?
  tanggalPublish  DateTime? @map("tanggal_publish")
  isHighlight     Boolean   @default(false) @map("is_highlight")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  isPublished     Boolean   @default(true) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy   String?  @map("created_by")
  creator     User?    @relation(fields: [createdBy], references: [id])

  @@index([isPublished, tanggalPublish])
  @@index([kategori])
  @@map("artikel")
}

// ─── Infaq ────────────────────────────────────────────────────────────────────
model Donasi {
  id            String       @id @default(uuid())
  nama          String
  email         String?
  telepon       String?
  jenisProgram  String?      @map("jenis_program")
  namaProgram   String?      @map("nama_program")
  jumlah        Decimal      @db.Decimal(15, 2)
  pesan         String?
  buktiTransfer String?      @map("bukti_transfer")
  status        StatusDonasi @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("donasi")
}

enum StatusDonasi {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Rekening ─────────────────────────────────────────────────────────────────
model Rekening {
  id          String   @id @default(uuid())
  namaBank    String   @map("nama_bank")
  noRekening  String   @map("no_rekening")
  atasNama    String   @map("atas_nama")
  keterangan  String?
  qrisImage   String?  @map("qris_image")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("rekening")
}

// ─── Galeri (Kegiatan Ramadhan & Sholat Ied) ─────────────────────────────────
enum KategoriGaleri {
  RAMADHAN
  SHOLAT_IED
}

model Galeri {
  id         String         @id @default(uuid())
  judul      String
  foto       String
  kategori   KategoriGaleri
  keterangan String?
  tahun      Int            @default(2026)
  urutan     Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("galeri")
}

// ─── Dokumentasi Qurban ─────────────────────────────────────────────────────
model QurbanFoto {
  id         String   @id @default(uuid())
  judul      String
  foto       String
  keterangan String?
  tahun      Int
  urutan     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("qurban_foto")
}

// ─── Streaming (Mias TV) ──────────────────────────────────────────────────────
model Streaming {
  id        String   @id @default(uuid())
  judul     String
  url       String
  deskripsi String?
  isLive    Boolean  @default(false) @map("is_live")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("streaming")
}

// ─── Program Sosial ───────────────────────────────────────────────────────────
enum KategoriSosial {
  SANTUNAN_ANAK_YATIM
  AIR_GALON_GRATIS
  LAYANAN_KESEHATAN_IBU_ANAK
  ARMALAH_AL_MISKIN
  BANTUAN_PENGOBATAN
  ZAKAT_MAAL
}

model SosialFoto {
  id         String         @id @default(uuid())
  judul      String
  foto       String
  kategori   KategoriSosial
  deskripsi  String?
  tahun      Int
  urutan     Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("sosial_foto")
}

// ─── Data Mustahik ────────────────────────────────────────────────────────────
enum KategoriMustahik {
  YATIM
  JANDA
  FAKIR
  MISKIN
  GHARIM
  FII_SABILILLAH
  MUSAFIR
}

enum HakMustahik {
  PENERIMA_ZAKAT_MAL
  PENERIMA_ZAKAT_FITRI
  PENERIMA_BANTUAN_MIAS
  SEMUA
}

enum StatusMustahik {
  JAMAAH
  WARGA
  WARGA_LUAR
}

enum PrioritasMustahik {
  PRIORITAS_1
  PRIORITAS_2
  PRIORITAS_3
}

model Mustahik {
  id        String             @id @default(uuid())
  nama      String
  alamat    String?
  rt        String?
  rw        String?
  kabKota   String?            @map("kab_kota")
  provinsi  String?
  telepon   String?
  kategori  KategoriMustahik
  berhak    HakMustahik        @default(SEMUA)
  status    StatusMustahik?
  prioritas PrioritasMustahik?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("mustahik")
}

// ─── Divisi (untuk Program Infaq & Wakaf) ────────────────────────────────────
model Divisi {
  id        String   @id @default(uuid())
  nama      String   @unique
  deskripsi String?
  isActive  Boolean  @default(true) @map("is_active")
  urutan    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  programDonasi ProgramDonasi[]
  programWakaf  ProgramWakaf[]

  @@map("divisi")
}

// ─── Program Infaq ────────────────────────────────────────────────────────────
model ProgramDonasi {
  id          String   @id @default(uuid())
  kode        String?
  judul       String
  deskripsi   String?
  divisiId    String?  @map("divisi_id")
  divisi      Divisi?  @relation(fields: [divisiId], references: [id])
  target      Decimal  @db.Decimal(15, 2)
  terkumpul   Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  tampilWebsite Boolean @default(true) @map("tampil_website")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_donasi")
}

// ─── Program Wakaf ────────────────────────────────────────────────────────────
model ProgramWakaf {
  id          String   @id @default(uuid())
  kode        String?
  kegiatan    String
  deskripsi   String?
  divisiId    String?  @map("divisi_id")
  divisi      Divisi?  @relation(fields: [divisiId], references: [id])
  target      Decimal  @default(0) @db.Decimal(15, 2)
  terkumpul   Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  tampilWebsite Boolean @default(true) @map("tampil_website")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_wakaf")
}

// ─── Pendidikan ───────────────────────────────────────────────────────────────
enum KategoriPendidikan {
  TAHSIN_IKHWAN
  TAHSIN_AKHWAT
  BAHASA_ARAB_IKHWAN
  BAHASA_ARAB_AKHWAT
  TPQ
}

model PendidikanInfo {
  id                 String              @id @default(uuid())
  kategori           KategoriPendidikan  @unique
  pengajar           String              // JSON array string e.g. '["Ustadz A","Ustadz B"]'
  jumlahPenuntutIlmu Int                 @default(0) @map("jumlah_penuntut_ilmu")
  kitab              String              // JSON array string e.g. '["Kitab A","Kitab B"]'
  deskripsi          String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("pendidikan_info")
}

model PendidikanFoto {
  id         String             @id @default(uuid())
  kategori   KategoriPendidikan
  judul      String
  foto       String
  keterangan String?
  tahun      Int
  urutan     Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@map("pendidikan_foto")
}

// ─── Usaha: Umroh ─────────────────────────────────────────────────────────────
model UmrohProgram {
  id          String   @id @default(uuid())
  judul       String
  flyer       String
  deskripsi   String?
  harga       Decimal? @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("umroh_program")
}

// ─── Usaha: Mias Mart ─────────────────────────────────────────────────────────
model MiasMartProduk {
  id          String   @id @default(uuid())
  nama        String
  foto        String
  harga       Decimal  @db.Decimal(15, 2)
  deskripsi   String?
  linkBeli    String?  @map("link_beli")
  stok        String?
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("mias_mart_produk")
}

// ─── Profil: Sejarah ─────────────────────────────────────────────────────────
model ProfilSejarah {
  id        Int      @id @default(1)
  konten    String?
  foto      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profil_sejarah")
}

// ─── Profil: Visi Misi ────────────────────────────────────────────────────────
model ProfilVisiMisi {
  id        Int      @id @default(1)
  visi      String?
  misi      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profil_visi_misi")
}

// ─── Profil: Fasilitas ────────────────────────────────────────────────────────
model ProfilFasilitas {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String?
  urutan    Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  foto      ProfilFasilitasFoto[]

  @@map("profil_fasilitas")
}

model ProfilFasilitasFoto {
  id          String          @id @default(uuid())
  fasilitasId String          @map("fasilitas_id")
  fasilitas   ProfilFasilitas @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)
  foto        String
  caption     String?
  urutan      Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("profil_fasilitas_foto")
}

// ─── Profil: Struktur Organisasi ─────────────────────────────────────────────
model ProfilStruktur {
  id         Int      @id @default(1)
  foto       String?
  keterangan String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profil_struktur")
}

// ─── Profil: Pemateri ────────────────────────────────────────────────────────
model ProfilPemateri {
  id         String        @id @default(uuid())
  nama       String
  foto       String?
  kitab      String?
  jenis      JenisPemateri @default(RUTIN)
  hari       String?       // e.g. "Senin, Rabu" comma-separated (only for RUTIN)
  waktu      String?       // e.g. "Pekan 1, Pekan 3" comma-separated (only for RUTIN)
  jam        String?       // e.g. "Ba'da Maghrib - Selesai" (only for RUTIN)
  keterangan String?
  youtube    String?
  urutan     Int           @default(0)
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("profil_pemateri")
}

enum JenisPemateri {
  RUTIN
  TEMATIK
}

// ─── Hero Banner ──────────────────────────────────────────────────────────────
model HeroBanner {
  id        String   @id @default(uuid())
  gambar    String
  urutan    Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_banner")
}

// ─── Site Settings ────────────────────────────────────────────────────────────
model SiteSetting {
  id             Int      @id @default(1)
  facebook       String?
  instagram      String?
  youtube        String?
  whatsapp       String?
  alamat         String?
  telepon        String?
  email          String?
  jamOperasional String?  @map("jam_operasional")
  popupImage     String?  @map("popup_image")
  popupUrl       String?  @map("popup_url")
  popupIsActive  Boolean  @default(false) @map("popup_is_active")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─── Kontak / Pesan ───────────────────────────────────────────────────────────
model Pesan {
  id        String   @id @default(uuid())
  nama      String
  email     String
  noHp      String   @map("no_hp")
  kategori  KategoriPesan
  subjek    String?
  pesan     String
  isRead    Boolean  @default(false) @map("is_read")
  status    StatusPesan @default(BELUM_DITINDAKLANJUTI)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pesan")
}

enum KategoriPesan {
  FASILITAS
  DIVISI_DAKWAH
  DIVISI_PENDIDIKAN
  DIVISI_SOSIAL
  UMROH
  PEMBELIAN_PRODUK_MIAS_MART
  LAIN_LAIN
}

enum StatusPesan {
  BELUM_DITINDAKLANJUTI
  SUDAH_DITINDAKLANJUTI
}

// ═══════════════════════════════════════════════════════════════════════════════
// ─── FINANCE MODULE (KEUANGAN) ────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Finance Enums ────────────────────────────────────────────────────────────
enum AccountType {
  CASH    // Kas
  BANK    // Bank
}

enum TransactionType {
  IN      // Pemasukan
  OUT     // Pengeluaran
}

enum ProgramType {
  INFAQ   // Dari program_donasi
  WAKAF   // Dari program_wakaf
}

enum ReconciliationStatus {
  PENDING     // Belum di-match
  MATCHED     // Sudah cocok dengan transaksi
  UNMATCHED   // Tidak ada pasangan
}

// ─── Finance Accounts ─────────────────────────────────────────────────────────
model FinanceAccount {
  id            String   @id @default(uuid())
  name          String
  type          AccountType
  accountNumber String?  @map("account_number")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transactions       FinanceTransaction[]
  bankImports        FinanceBankImport[]
  bankImportDetails  FinanceBankImportDetail[]

  @@map("finance_accounts")
}

// ─── Finance Transactions ─────────────────────────────────────────────────────
model FinanceTransaction {
  id              String           @id @default(uuid())
  accountId       String           @map("account_id")
  transactionDate DateTime         @map("transaction_date")
  type            TransactionType
  amount          Decimal          @db.Decimal(15, 2)
  uniqueCode      Int?             @map("unique_code") // 3 digit kode unik (001-999)
  transactionCode String?          @map("transaction_code") // Kode transaksi unik, otomatis untuk akun CASH atau dari referensi rekonsiliasi
  actualAmount    Decimal?         @db.Decimal(15, 2) @map("actual_amount") // Nominal asli tanpa kode
  programType     ProgramType?     @map("program_type")
  programId       String?          @map("program_id") // ID dari program_donasi atau program_wakaf
  programName     String?          @map("program_name") // Nama program untuk display
  category        String?          // Kategori transaksi
  description     String?
  notes           String?
  attachment      String?          // Bukti transfer
  createdBy       String?          @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  account         FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reconciliations FinanceReconciliation[]

  @@index([accountId])
  @@index([transactionCode])
  @@index([transactionDate])
  @@index([type])
  @@index([programType, programId])
  @@map("finance_transactions")
}

// ─── Finance Bank Imports (Header) ────────────────────────────────────────────
model FinanceBankImport {
  id              String   @id @default(uuid())
  accountId       String   @map("account_id")
  fileName        String   @map("file_name")
  uploadedBy      String?  @map("uploaded_by")
  totalRows       Int      @default(0) @map("total_rows")
  insertedRows    Int      @default(0) @map("inserted_rows")
  skippedRows     Int      @default(0) @map("skipped_rows") // Duplicate
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  account         FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  details         FinanceBankImportDetail[]

  @@index([accountId])
  @@index([uploadedAt])
  @@map("finance_bank_imports")
}

// ─── Finance Bank Import Details (Mutasi Bank = SOURCE OF TRUTH) ──────────────
model FinanceBankImportDetail {
  id              String   @id @default(uuid())
  importId        String   @map("import_id")
  accountId       String   @map("account_id")
  transactionId   String?  @map("transaction_id") // ID/Reference dari bank (WAJIB UNIQUE per account)
  transactionDate DateTime @map("transaction_date")
  description     String
  debit           Decimal? @db.Decimal(15, 2)
  credit          Decimal? @db.Decimal(15, 2)
  balance         Decimal  @db.Decimal(15, 2)
  programCode     String?  @map("program_code")
  programType     String?  @map("program_type")
  programId       String?  @map("program_id")
  programName     String?  @map("program_name")
  rowHash         String   @map("row_hash")
  divisiId        String?  @map("divisi_id")
  divisiNama      String?  @map("divisi_nama")
  createdAt       DateTime @default(now()) @map("created_at")

  import          FinanceBankImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  account         FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reconciliations FinanceReconciliation[]

  // ANTI DUPLICATE: Constraints untuk mencegah import duplicate
  @@unique([transactionId, accountId])
  @@unique([accountId, rowHash])
  @@index([importId])
  @@index([accountId])
  @@index([transactionDate])
  @@map("finance_bank_import_details")
}

// ─── Finance Reconciliation (Matching) ────────────────────────────────────────
model FinanceReconciliation {
  id                    String                @id @default(uuid())
  transactionId         String?               @map("transaction_id") // Internal transaction
  bankImportDetailId    String?               @map("bank_import_detail_id") // Mutasi bank
  status                ReconciliationStatus  @default(PENDING)
  matchedBy             String?               @map("matched_by")
  matchedAt             DateTime?             @map("matched_at")
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  transaction           FinanceTransaction?        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bankImportDetail      FinanceBankImportDetail?   @relation(fields: [bankImportDetailId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@index([bankImportDetailId])
  @@map("finance_reconciliations")
}

// ─── Finance Audit Trail ──────────────────────────────────────────────────────
model FinanceAudit {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, IMPORT, RECONCILE
  entityType  String   @map("entity_type") // ACCOUNT, TRANSACTION, BANK_IMPORT, RECONCILIATION
  entityId    String?  @map("entity_id")
  oldData     String?  @db.Text @map("old_data") // JSON
  newData     String?  @db.Text @map("new_data") // JSON
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("finance_audits")
}
