// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (Admin) ─────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  nama      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artikel  Artikel[]
  kajian   Kajian[]

  @@map("users")
}

enum Role {
  ADMIN
  SUPERADMIN
  SOSIAL
  DAKWAH
  PENDIDIKAN
  USAHA
}

// ─── Role Permissions ─────────────────────────────────────────────────────────
model RolePermission {
  id      String @id @default(uuid())
  role    Role
  menuKey String @map("menu_key")

  @@unique([role, menuKey])
  @@map("role_permissions")
}

// ─── Kajian ───────────────────────────────────────────────────────────────────
model Kajian {
  id          String   @id @default(uuid())
  judul       String
  ustadz      String
  tanggal     DateTime
  waktu       String
  lokasi      String?
  deskripsi   String?
  thumbnail   String?
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   String?  @map("created_by")
  creator     User?    @relation(fields: [createdBy], references: [id])

  @@map("kajian")
}

// ─── Artikel ──────────────────────────────────────────────────────────────────
model Artikel {
  id              String    @id @default(uuid())
  judul           String
  slug            String    @unique
  konten          String
  ringkasan       String?
  thumbnail       String?
  kategori        String?
  tanggalPublish  DateTime? @map("tanggal_publish")
  isHighlight     Boolean   @default(false) @map("is_highlight")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  isPublished     Boolean   @default(true) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy   String?  @map("created_by")
  creator     User?    @relation(fields: [createdBy], references: [id])

  @@index([isPublished, tanggalPublish])
  @@index([kategori])
  @@map("artikel")
}

// ─── Infaq ────────────────────────────────────────────────────────────────────
model Donasi {
  id            String       @id @default(uuid())
  nama          String
  email         String?
  telepon       String?
  jenisProgram  String?      @map("jenis_program")
  namaProgram   String?      @map("nama_program")
  jumlah        Decimal      @db.Decimal(15, 2)
  pesan         String?
  buktiTransfer String?      @map("bukti_transfer")
  status        StatusDonasi @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("donasi")
}

enum StatusDonasi {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Rekening ─────────────────────────────────────────────────────────────────
model Rekening {
  id          String   @id @default(uuid())
  namaBank    String   @map("nama_bank")
  noRekening  String   @map("no_rekening")
  atasNama    String   @map("atas_nama")
  keterangan  String?
  qrisImage   String?  @map("qris_image")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("rekening")
}

// ─── Galeri (Kegiatan Ramadhan & Sholat Ied) ─────────────────────────────────
enum KategoriGaleri {
  RAMADHAN
  SHOLAT_IED
}

model Galeri {
  id         String         @id @default(uuid())
  judul      String
  foto       String
  kategori   KategoriGaleri
  keterangan String?
  tahun      Int            @default(2026)
  urutan     Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("galeri")
}

// ─── Dokumentasi Qurban ─────────────────────────────────────────────────────
model QurbanFoto {
  id         String   @id @default(uuid())
  judul      String
  foto       String
  keterangan String?
  tahun      Int
  urutan     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("qurban_foto")
}

// ─── Streaming (Mias TV) ──────────────────────────────────────────────────────
model Streaming {
  id        String   @id @default(uuid())
  judul     String
  url       String
  deskripsi String?
  isLive    Boolean  @default(false) @map("is_live")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("streaming")
}

// ─── Program Sosial ───────────────────────────────────────────────────────────
enum KategoriSosial {
  SANTUNAN_ANAK_YATIM
  AIR_GALON_GRATIS
  LAYANAN_KESEHATAN_IBU_ANAK
  ARMALAH_AL_MISKIN
  BANTUAN_PENGOBATAN
  ZAKAT_MAAL
}

model SosialFoto {
  id         String         @id @default(uuid())
  judul      String
  foto       String
  kategori   KategoriSosial
  deskripsi  String?
  tahun      Int
  urutan     Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@map("sosial_foto")
}

// ─── Data Mustahik ────────────────────────────────────────────────────────────
enum KategoriMustahik {
  YATIM
  JANDA
  FAKIR
  MISKIN
  GHARIM
  FII_SABILILLAH
  MUSAFIR
}

enum HakMustahik {
  PENERIMA_ZAKAT_MAL
  PENERIMA_ZAKAT_FITRI
  PENERIMA_BANTUAN_MIAS
  SEMUA
}

model Mustahik {
  id        String           @id @default(uuid())
  nama      String
  alamat    String?
  kabKota   String?          @map("kab_kota")
  provinsi  String?
  telepon   String?
  kategori  KategoriMustahik
  berhak    HakMustahik      @default(SEMUA)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("mustahik")
}

// ─── Program Infaq ────────────────────────────────────────────────────────────
model ProgramDonasi {
  id          String   @id @default(uuid())
  kode        String?
  judul       String
  deskripsi   String?
  target      Decimal  @db.Decimal(15, 2)
  terkumpul   Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_donasi")
}

// ─── Program Wakaf ────────────────────────────────────────────────────────────
model ProgramWakaf {
  id          String   @id @default(uuid())
  kode        String?
  kegiatan    String
  deskripsi   String?
  target      Decimal  @default(0) @db.Decimal(15, 2)
  terkumpul   Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_wakaf")
}

// ─── Pendidikan ───────────────────────────────────────────────────────────────
enum KategoriPendidikan {
  TAHSIN_IKHWAN
  TAHSIN_AKHWAT
  BAHASA_ARAB_IKHWAN
  BAHASA_ARAB_AKHWAT
  TPQ
}

model PendidikanInfo {
  id                 String              @id @default(uuid())
  kategori           KategoriPendidikan  @unique
  pengajar           String              // JSON array string e.g. '["Ustadz A","Ustadz B"]'
  jumlahPenuntutIlmu Int                 @default(0) @map("jumlah_penuntut_ilmu")
  kitab              String              // JSON array string e.g. '["Kitab A","Kitab B"]'
  deskripsi          String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("pendidikan_info")
}

model PendidikanFoto {
  id         String             @id @default(uuid())
  kategori   KategoriPendidikan
  judul      String
  foto       String
  keterangan String?
  tahun      Int
  urutan     Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@map("pendidikan_foto")
}

// ─── Usaha: Umroh ─────────────────────────────────────────────────────────────
model UmrohProgram {
  id          String   @id @default(uuid())
  judul       String
  flyer       String
  deskripsi   String?
  harga       Decimal? @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("umroh_program")
}

// ─── Usaha: Mias Mart ─────────────────────────────────────────────────────────
model MiasMartProduk {
  id          String   @id @default(uuid())
  nama        String
  foto        String
  harga       Decimal  @db.Decimal(15, 2)
  deskripsi   String?
  linkBeli    String?  @map("link_beli")
  stok        String?
  isActive    Boolean  @default(true) @map("is_active")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("mias_mart_produk")
}

// ─── Profil: Sejarah ─────────────────────────────────────────────────────────
model ProfilSejarah {
  id        Int      @id @default(1)
  konten    String?
  foto      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profil_sejarah")
}

// ─── Profil: Visi Misi ────────────────────────────────────────────────────────
model ProfilVisiMisi {
  id        Int      @id @default(1)
  visi      String?
  misi      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profil_visi_misi")
}

// ─── Profil: Fasilitas ────────────────────────────────────────────────────────
model ProfilFasilitas {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String?
  urutan    Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  foto      ProfilFasilitasFoto[]

  @@map("profil_fasilitas")
}

model ProfilFasilitasFoto {
  id          String          @id @default(uuid())
  fasilitasId String          @map("fasilitas_id")
  fasilitas   ProfilFasilitas @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)
  foto        String
  caption     String?
  urutan      Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("profil_fasilitas_foto")
}

// ─── Profil: Struktur Organisasi ─────────────────────────────────────────────
model ProfilStruktur {
  id         Int      @id @default(1)
  foto       String?
  keterangan String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profil_struktur")
}

// ─── Profil: Pemateri ────────────────────────────────────────────────────────
model ProfilPemateri {
  id         String        @id @default(uuid())
  nama       String
  foto       String?
  kitab      String?
  jenis      JenisPemateri @default(RUTIN)
  waktu      String?       // e.g. "Pekan 1, Pekan 3" comma-separated (only for RUTIN)
  jam        String?       // e.g. "Ba'da Maghrib - Selesai" (only for RUTIN)
  keterangan String?
  youtube    String?
  urutan     Int           @default(0)
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("profil_pemateri")
}

enum JenisPemateri {
  RUTIN
  TEMATIK
}

// ─── Hero Banner ──────────────────────────────────────────────────────────────
model HeroBanner {
  id        String   @id @default(uuid())
  gambar    String
  urutan    Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_banner")
}

// ─── Site Settings ────────────────────────────────────────────────────────────
model SiteSetting {
  id             Int      @id @default(1)
  facebook       String?
  instagram      String?
  youtube        String?
  whatsapp       String?
  alamat         String?
  telepon        String?
  email          String?
  jamOperasional String?  @map("jam_operasional")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ─── Kontak / Pesan ───────────────────────────────────────────────────────────
model Pesan {
  id        String   @id @default(uuid())
  nama      String
  email     String
  noHp      String   @map("no_hp")
  kategori  KategoriPesan
  subjek    String?
  pesan     String
  isRead    Boolean  @default(false) @map("is_read")
  status    StatusPesan @default(BELUM_DITINDAKLANJUTI)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pesan")
}

enum KategoriPesan {
  FASILITAS
  DIVISI_DAKWAH
  DIVISI_PENDIDIKAN
  DIVISI_SOSIAL
  UMROH
  PEMBELIAN_PRODUK_MIAS_MART
  LAIN_LAIN
}

enum StatusPesan {
  BELUM_DITINDAKLANJUTI
  SUDAH_DITINDAKLANJUTI
}
